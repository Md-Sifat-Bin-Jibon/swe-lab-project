# Auth
JWT_SECRET=swapspot-dev-secret-change-me

# App URL used for links in emails
APP_URL=http://localhost:3000

# SMTP (OTP emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@example.com
SMTP_PASS=your-app-password
SMTP_FROM="SwapSpot <you@example.com>"

# OpenAI (AI-generated swap to-dos). Without a key, a built-in template plan is used.
OPENAI_API_KEY=
# Optional: any Chat Completions model that supports Structured Outputs
OPENAI_MODEL=gpt-4.1-mini

# Admin panel (/admin) — the first admin is created from these on first run
ADMIN_EMAIL=admin@swapspot.test
ADMIN_PASSWORD=admin12345

# Google Meet links (Calendar API). Without these, meetings use a SwapSpot room link.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary
# Optional: point the Google calls at a stub while testing.
# GOOGLE_TOKEN_URL=
# GOOGLE_CALENDAR_API_BASE=
